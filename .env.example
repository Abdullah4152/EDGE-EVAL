# ─────────────────────────────────────────────────────────
# EdgeEval — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to git.
# ─────────────────────────────────────────────────────────

# HuggingFace token for LLaMA (requires access request approval)
LLAMA_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLAMA_HF_USERNAME=your_llama_hf_username

# HuggingFace token for Qwen (public, any HF token works)
QWEN_HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
QWEN_HF_USERNAME=your_qwen_hf_username

# Single token (if using the same account for both)
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HF_USERNAME=your_hf_username

# NVIDIA NIM API key (for LLM-as-judge in eval_metrics.py)
# Get one at: https://build.nvidia.com
NVIDIA_API_KEY=nvapi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Dataset paths (defaults to ./data/eval if not set)
DATASET_BASE=./data/eval

# Adapter directories (defaults shown; override if using Kaggle input paths)
QWEN_ADAPTERS_DIR=./fine_tuned_adapters/qwen
LLAMA_ADAPTERS_DIR=./fine_tuned_adapters/llama
QWEN_CSV=./training_energy_log_qwen.csv
LLAMA_CSV=./training_energy_log_llama.csv
